page {
  background: #f4f1ea;
  color: #1f1d1a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #d8cfbf;
  border-radius: 14rpx;
  background: #fffdfa;
  box-shadow: 0 14rpx 38rpx rgba(42, 31, 19, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.muted {
  color: #6c675f;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.btn {
  min-height: 78rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #15584d;
  color: #fff;
  font-weight: 700;
  line-height: 78rpx;
}

.btn.secondary {
  background: #fffdfa;
  border: 1rpx solid #d8cfbf;
  color: #1f1d1a;
}

.btn.warn {
  background: #bf5d35;
}

.input,
.textarea,
.picker {
  min-height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8cfbf;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.textarea {
  min-height: 150rpx;
  padding-top: 18rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #6c675f;
  font-size: 24rpx;
}

.risk {
  min-width: 54rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.risk.H {
  background: #c45246;
}

.risk.M {
  background: #d8a335;
  color: #563d0e;
}

.risk.L {
  background: #5b9464;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.metric {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f4eb;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.empty {
  padding: 28rpx;
  color: #6c675f;
  text-align: center;
}

.danger-text {
  color: #c45246;
  font-weight: 700;
}
