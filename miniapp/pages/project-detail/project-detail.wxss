.compact {
  min-width: 140rpx;
  padding: 0 18rpx;
}

.metric-value.small {
  font-size: 30rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e7dece;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-weight: 800;
  margin-bottom: 4rpx;
  line-height: 1.35;
  word-break: break-all;
}
