.actions {
  align-items: stretch;
}

.compact {
  min-width: 140rpx;
  padding: 0 18rpx;
}

.task-row,
.project-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e7dece;
}

.task-row:last-child,
.project-row:last-child {
  border-bottom: 0;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title,
.project-name {
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.task-title {
  margin-bottom: 4rpx;
}

.project-row {
  justify-content: space-between;
}

.project-progress {
  min-width: 120rpx;
  text-align: right;
  font-weight: 800;
}
